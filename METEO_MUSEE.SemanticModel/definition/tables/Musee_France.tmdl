	column 'Crédit photo'
		dataType: string
		lineageTag: 90257820-2acf-4c83-863b-48fa4e10e51a
		summarizeBy: none
		sourceColumn: Crédit photo

		annotation SummarizationSetBy = Automatic

	column 'URL icône Meteocons'
		dataType: string
		lineageTag: d0f7638c-80bc-4800-927c-d20c6a954449
		summarizeBy: none
		sourceColumn: URL icône Meteocons

		annotation SummarizationSetBy = Automatic

	partition Musee_France = m
		mode: import
		source = ```
				let
				    // Référentiel commun des musées (voir requête Referentiel_Musees)
				    Source = Referentiel_Musees,
				    // Appelle l'API météo actuelle pour chaque musée à partir de ses coordonnées
				    #"Appeler API météo actuelle" = Table.AddColumn(Source, "Meteo", each Json.Document(Web.Contents(
				        "https://api.openweathermap.org",
				        [ RelativePath = "data/2.5/weather",
				          Query = [ lat = [Valeur], lon = [ValeurLong], APPID = ApiKey, units = "Metric" ] ]))),
				    // Ne développe que les champs utiles de la réponse JSON
				    #"Développer réponse API" = Table.ExpandRecordColumn(#"Appeler API météo actuelle", "Meteo", {"weather", "main", "wind", "dt", "timezone", "id"}, {"weather", "main", "wind", "dt", "timezone", "id"}),
				    // weather est une liste : l'API peut renvoyer plusieurs conditions simultanées (d'où la déduplication en fin de requête)
				    #"Développer conditions météo" = Table.ExpandListColumn(#"Développer réponse API", "weather"),
				    #"Développer détail condition" = Table.ExpandRecordColumn(#"Développer conditions météo", "weather", {"description", "icon"}, {"description", "icon"}),
				    #"Développer mesures" = Table.ExpandRecordColumn(#"Développer détail condition", "main", {"temp", "feels_like", "temp_min", "temp_max", "pressure", "humidity"}, {"temp", "feels_like", "temp_min", "temp_max", "pressure", "humidity"}),
				    #"Développer vent" = Table.ExpandRecordColumn(#"Développer mesures", "wind", {"speed", "deg"}, {"speed", "degrees"}),
				    // Convertit le timestamp Unix (dt, UTC) en date/heure locale du musée en ajoutant le décalage horaire fourni par l'API (timezone, en secondes, heure d'été incluse)
				    #"Calculer date locale" = Table.AddColumn(#"Développer vent", "date", each #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, [dt] + [timezone]), type datetime),
				    // Direction du vent en toutes lettres (16 secteurs de 22,5°)
				    #"Ajouter direction vent" = Table.AddColumn(#"Calculer date locale", "wind direction description", each if [degrees] >= 348.75 then "Nord" else if [degrees] > 326.25 then "Nord-nord-ouest" else if [degrees] > 303.75 then "Nord-ouest" else if [degrees] > 281.25 then "Ouest-nord-ouest" else if [degrees] > 258.75 then "Ouest" else if [degrees] > 236.25 then "Ouest-sud-ouest" else if [degrees] > 213.75 then "Sud-ouest" else if [degrees] > 191.25 then "Sud-sud-ouest" else if [degrees] > 168.75 then "Sud" else if [degrees] > 146.25 then "Sud-sud-est" else if [degrees] > 123.75 then "Sud-est" else if [degrees] > 101.25 then "Est-sud-est" else if [degrees] > 78.75 then "Est" else if [degrees] > 56.25 then "Est-nord-est" else if [degrees] > 33.75 then "Nord-est" else if [degrees] > 11.25 then "Nord-nord-est" else if [degrees] >= 0 then "Nord" else null, type text),
				    // Fusion avec Wallpaper sur la condition météo (en anglais) : image de fond et libellé français
				    #"Fusionner Wallpaper" = Table.NestedJoin(#"Ajouter direction vent", {"description"}, Fonds_Meteo, {"Weather"}, "Wallpaper", JoinKind.LeftOuter),
				    #"Développer Wallpaper" = Table.ExpandTableColumn(#"Fusionner Wallpaper", "Wallpaper", {"URL", "Weather - Francais", "Unsplash Credit", "Icône"}, {"URL.1", "Weather - Francais", "Unsplash Credit", "Icône"}),
				       // Crédit photo lisible (« Photo : Nom / Unsplash ») extrait du code HTML fourni par Unsplash
				    #"Ajouter crédit photo" = Table.AddColumn(#"Développer Wallpaper", "Crédit photo", each if [Unsplash Credit] = null then null else "Photo : " & Text.Trim(Text.BetweenDelimiters([Unsplash Credit], ">", "<")) & " / Unsplash", type text),
				    // URL de l'icône Meteocons (Bas Milius, licence MIT) : variante jour/nuit selon le code OpenWeather (d/n) ; icône OpenWeather en secours si la condition est absente de Fonds_Meteo
				    #"Ajouter URL icône" = Table.AddColumn(#"Ajouter crédit photo", "URL icône Meteocons", each if [Icône] = null then "https://openweathermap.org/img/w/" & [icon] & ".png" else "https://cdn.jsdelivr.net/npm/@bybas/weather-icons@2.0.0/production/line/all/" & Text.Replace([Icône], "[dn]", if Text.End([icon], 1) = "n" then "night" else "day") & ".svg", type text),
				    
				    // Force du vent selon l'échelle de Beaufort (vitesse en m/s)
				    #"Ajouter force vent" = Table.AddColumn( #"Ajouter URL icône", "Wind speed desciption", each if [speed] >= 32 then "Ouragan" else if [speed] >= 28 then "Violente tempête" else if [speed] >= 24 then "Fort coup de vent" else if [speed] >= 20.5 then "Coup de vent" else if [speed] >= 17 then "Grand vent frais" else if [speed] >= 11 then "Vent frais" else if [speed] >= 8.5 then "Bonne brise" else if [speed] >= 5.5 then "Jolie brise" else if [speed] >= 3.5 then "Petite brise" else if [speed] >= 2 then "Légère brise" else if [speed] >= 0.5 then "Très légère brise" else "Calme", type text),
				    // Code postal CEDEX de la BNU (67070) remplacé par le code postal standard, pour un itinéraire correct
				    #"Corriger code postal BNU" = Table.ReplaceValue(#"Ajouter force vent", "67070", "67000", Replacer.ReplaceText, {"Adresse"}),
				    // Lien Google Maps (itinéraire) à partir de l'adresse brute. À vérifier : probablement inutilisé (remplacé par Itinéraire formate)
				    #"Ajouter lien itinéraire" = Table.AddColumn(#"Corriger code postal BNU", "itiniraire", each "https://www.google.com/maps/dir//" & [Adresse], type text),
				    // Lien Google Maps (itinéraire) à partir de l'adresse formatée : utilisé par le bouton Itinéraire
				    #"Ajouter lien itinéraire formaté" = Table.AddColumn(#"Ajouter lien itinéraire", "Itinéraire formate", each "https://www.google.com/maps/dir//" & [Adresse formatee], type text),
				    // Nettoie les URL museumspass : parenthèses et guillemets remplacés par des tirets, apostrophes supprimées (format des URL du site)
				    #"Nettoyer liens museumspass" = Table.TransformColumns(#"Ajouter lien itinéraire formaté", {{"Lien info pratiques", each Text.Replace(Text.Replace(Text.Replace(Text.Replace(_, "(", "-"), ")", "-"), "'", ""), """", "-"), type text}}),
				    // Deux URL museumspass qui ne suivent pas la règle générale : corrigées à la main
				    #"Corriger lien Schoelcher" = Table.ReplaceValue(#"Nettoyer liens museumspass", "https://www.museumspass.com/fr/musee/Espace-muséographique-«Victor-Schoelcher,-son-œuvre»", "https://www.museumspass.com/fr/musee/espace-museographique-victor-schoelcher-son-oeuvre", Replacer.ReplaceText, {"Lien info pratiques"}),
				    #"Corriger lien Frac" = Table.ReplaceValue(#"Corriger lien Schoelcher", "https://www.museumspass.com/fr/musee/Fonds-régional-dart-contemporain--Frac--de-Franche-Comté", "https://www.museumspass.com/fr/musee/fonds-regional-dart-contemporain-frac-de-franche-comte", Replacer.ReplaceText, {"Lien info pratiques"}),
				    #"Supprimer doubles tirets" = Table.ReplaceValue(#"Corriger lien Frac", "--", "-", Replacer.ReplaceText, {"Lien info pratiques"}),
				    // Libellé du segment : espace avant le tiret (« Musée - Ville »)
				    #"Formater libellé segment" = Table.ReplaceValue(#"Supprimer doubles tirets", "- ", " - ", Replacer.ReplaceText, {"Segment musee et ville"}),
				    // Lien vers la page OpenWeather de la ville du musée (bouton « Voir la météo en temps réel »)
				    #"Ajouter lien OpenWeather" = Table.AddColumn(#"Formater libellé segment", "lien url vers site meteo", each "https://openweathermap.org/city/" & Text.From([id]), type text),
				    // Une ligne par musée (voir commentaire sur la liste weather)
				    #"Supprimer doublons musée" = Table.Distinct(#"Ajouter lien OpenWeather", {"Musee"}),
				    // Ne conserve que les colonnes utilisées par le rapport (visuels, mesures, tri du segment, relation)
				    #"Garder colonnes utiles" = Table.SelectColumns(#"Supprimer doublons musée", {"Musee", "Segment musee et ville", "Ville et musee (colonne ref)", "Lien info pratiques", "itiniraire", "Itinéraire formate", "lien url vers site meteo", "URL.1", "Crédit photo", "URL icône Meteocons", "icon", "Weather - Francais", "temp", "feels_like", "temp_min", "temp_max", "pressure", "humidity", "speed", "wind direction description", "Wind speed desciption", "date"}),
				    // Typage final et explicite de toutes les colonnes conservées
				    #"Typer colonnes" = Table.TransformColumnTypes(#"Garder colonnes utiles", {{"Musee", type text}, {"Segment musee et ville", type text}, {"Ville et musee (colonne ref)", type text}, {"Lien info pratiques", type text}, {"itiniraire", type text}, {"Itinéraire formate", type text}, {"lien url vers site meteo", type text}, {"URL.1", type text}, {"Crédit photo", type text}, {"URL icône Meteocons", type text}, {"icon", type text}, {"Weather - Francais", type text}, {"temp", type number}, {"feels_like", type number}, {"temp_min", type number}, {"temp_max", type number}, {"pressure", Int64.Type}, {"humidity", Int64.Type}, {"speed", type number}, {"wind direction description", type text}, {"Wind speed desciption", type text}, {"date", type datetime}}),
				    #"Colonnes renommées" = Table.RenameColumns(#"Typer colonnes",{{"pressure", "Pression (hPa)"}, {"temp_max", "Température max instantanée (°C)"}, {"temp_min", "Température min instantanée (°C)"}, {"humidity", "Humidité (%)"}, {"speed", "Vitesse du vent (m/s)"}, {"wind direction description", "Direction du vent"}, {"Wind speed desciption", "Force du vent"}, {"feels_like", "Température ressentie (°C)"}, {"URL.1", "URL image de fond"}, {"Weather - Francais", "Condition météo"}, {"temp", "Température (°C)"}, {"icon", "Code icône"}})
				in
				    #"Colonnes renommées"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

