/// URL du classeur Excel du référentiel des musées. À adapter selon l'emplacement du fichier
expression CheminSource = "https://votre-tenant-my.sharepoint.com/personal/votre_compte/Documents/GEOLOCALISATION_MUSEE_FRANCE.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: aef1bb7a-0d83-455a-a186-2359afdec631

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// Référentiel commun des musées (128 lignes, issu du Museums-PASS). Requête intermédiaire non chargée, utilisée par Musee France et Musee France Prévision.
expression Referentiel_Musees =
		let
		    // Classeur Excel du référentiel des musées (emplacement défini par le paramètre CheminSource)
		    Source = Excel.Workbook(Web.Contents(CheminSource), null, true),
		    Feuille = Source{[Item="Feuil1",Kind="Sheet"]}[Data],
		    #"Promouvoir en-têtes" = Table.PromoteHeaders(Feuille, [PromoteAllScalars=true]),
		    // Toutes les colonnes en texte : lat/lon restent en texte avec un point, format attendu par l'API
		    #"Typer colonnes" = Table.TransformColumnTypes(#"Promouvoir en-têtes", List.Transform(Table.ColumnNames(#"Promouvoir en-têtes"), each {_, type text}))
		in
		    #"Typer colonnes"
	lineageTag: 918f17a9-6d10-497c-962a-d86366f88e34

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Table de correspondance saisie manuellement : une ligne par condition météo OpenWeather (17 conditions, libellé anglais tel que renvoyé par l'API), avec l'URL d'une image de fond Unsplash, le crédit photo et le libellé français. Utilisée par les fusions Power Query de Musee_France et Musee_France_Prevision. Limite : une condition absente de la liste n'a ni image ni libellé français.
expression Fonds_Meteo =
		let
		    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Weather = _t, URL = _t, #"Unsplash Credit" = _t, #"Weather - Francais" = _t, Icône = _t]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Weather", type text}, {"URL", type text}})
		in
		    #"Changed Type"
	lineageTag: 2a483267-2dd2-43bd-b9a6-29bf4fb541a7

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

