/// Une ligne par musée du Museums-PASS (128 musées, côté français). Combine le référentiel Excel (nom, adresse, coordonnées, lien d'infos pratiques) et la météo actuelle de l'API OpenWeather (endpoint weather) : température, ressenti, pression, humidité, vent et condition météo. Mise à jour à chaque actualisation (128 appels API). Alimente la page Musée et le segment de sélection.
table Musee_France
	lineageTag: 55b30872-0ffb-4f67-8210-7f4e14dadac8

	/// Nom du musée. Clé de la relation avec Musee_France_Prevision.
	column Musee
		dataType: string
		isHidden
		lineageTag: 5f275bcf-e1a1-4d68-b549-846adb2893ac
		summarizeBy: none
		sourceColumn: Musee

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Code d’icône OpenWeather (ex. 03d), utilisé pour construire l’URL de l’icône météo.
	column 'Code icône'
		dataType: string
		lineageTag: 2f373165-3f81-4132-b095-849c134a2eab
		summarizeBy: none
		sourceColumn: Code icône

		annotation SummarizationSetBy = Automatic

	/// Température actuelle en °C (API OpenWeather, units=metric).
	column 'Température (°C)'
		dataType: double
		lineageTag: c2f0cd12-c552-4c2c-b097-0c20972297ef
		summarizeBy: none
		sourceColumn: Température (°C)

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Température ressentie en °C, qui tient compte du vent et de l’humidité.
	column 'Température ressentie (°C)'
		dataType: double
		lineageTag: c2ed2b14-39d3-4c0a-99b3-dcc20be3a5ad
		summarizeBy: none
		sourceColumn: Température ressentie (°C)

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Température minimale observée au même instant dans la zone urbaine. Ce n’est pas le minimum de la journée ; souvent égale à la température actuelle.
	column 'Température min instantanée (°C)'
		dataType: double
		lineageTag: c1fc1faf-20da-4ebd-841c-73ff24908ea9
		summarizeBy: none
		sourceColumn: Température min instantanée (°C)

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Température maximale observée au même instant dans la zone urbaine. Ce n’est pas le maximum de la journée ; souvent égale à la température actuelle.
	column 'Température max instantanée (°C)'
		dataType: double
		lineageTag: bba5f329-31c4-4c55-9baf-ce4d8d4765df
		summarizeBy: none
		sourceColumn: Température max instantanée (°C)

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Pression atmosphérique au niveau de la mer, en hPa.
	column 'Pression (hPa)'
		dataType: int64
		formatString: 0
		lineageTag: a9f5e1d7-96e3-4eef-bc1b-536f50a1ca14
		summarizeBy: none
		sourceColumn: Pression (hPa)

		annotation SummarizationSetBy = Automatic

	/// Humidité relative, en %
	column 'Humidité (%)'
		dataType: int64
		lineageTag: 12be1dcd-8d9a-4df9-ad3b-3c5eb660a5a7
		summarizeBy: none
		sourceColumn: Humidité (%)

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Vitesse du vent (m/s)
	column 'Vitesse du vent (m/s)'
		dataType: double
		lineageTag: 12e587f0-8dcc-486a-8664-85a0bb73d86c
		summarizeBy: none
		sourceColumn: Vitesse du vent (m/s)

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Date et heure locales de la mesure météo (timestamp API converti en heure locale)
	column date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 20778946-945c-4039-826a-e4178070e0ca
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	/// Direction d’où vient le vent, en toutes lettres (16 secteurs).
	column 'Direction du vent'
		dataType: string
		lineageTag: a5fb4e35-861b-4196-a903-acdab34e9b53
		summarizeBy: none
		sourceColumn: Direction du vent

		annotation SummarizationSetBy = Automatic

	/// URL de l’image Unsplash associée à la condition météo actuelle (fond de la page Musée).
	column 'URL image de fond'
		dataType: string
		lineageTag: eca18e7b-bbdf-4378-943a-58fbc22b5068
		summarizeBy: none
		sourceColumn: URL image de fond

		annotation SummarizationSetBy = Automatic

	/// Condition météo actuelle en français (ex. « Nuages dispersés »), issue de Fonds_Meteo.
	column 'Condition météo'
		dataType: string
		lineageTag: 842b847a-d4a1-4b16-88c2-9419f52a0bd2
		summarizeBy: none
		sourceColumn: Condition météo

		annotation SummarizationSetBy = Automatic

	/// Colonne calculée DAX : URL de l'icône météo OpenWeather (https://openweathermap.org/img/w/{icon}.png) pour la condition actuelle du musée. Affichée à côté du libellé météo sur la page Musée.
	column 'URL icône météo' =
			
			// Reprend l'URL Meteocons construite dans Power Query (avec secours OpenWeather si la condition est inconnue)
			Musee_France[URL icône Meteocons]
		lineageTag: 5ce1dec7-b3b0-461d-b739-e36f6b8c2e92
		dataCategory: WebUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Qualification du vent selon l’échelle de Beaufort (ex. « Très légère brise »).
	column 'Force du vent'
		dataType: string
		lineageTag: bc81286c-fe01-44a8-a21f-a566682e52a8
		summarizeBy: none
		sourceColumn: Force du vent

		annotation SummarizationSetBy = Automatic

	/// Colonne technique conservée volontairement : lien Google Maps construit à partir de l'adresse brute. Plus utilisée pour la navigation (remplacée par Itinéraire formate), mais référencée par un réglage résiduel des boutons Itinéraire et Infos pratiques ; sa suppression casse ces boutons.
	column itiniraire
		dataType: string
		isHidden
		lineageTag: f85c2e2a-8c02-4f1a-be50-14ed57a78385
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: itiniraire

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// URL de la fiche du musée sur museumspass.com (bouton « Infos pratiques »).
	column 'Lien info pratiques'
		dataType: string
		lineageTag: 175702a8-e218-4862-82ba-d79f8ecf23b5
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: Lien info pratiques

		annotation SummarizationSetBy = Automatic

	/// Clé de tri (Ville - Musée) du segment : classe les musées par ville
	column 'Ville et musee (colonne ref)'
		dataType: string
		isHidden
		lineageTag: 44a8cfb9-82b4-4a5d-9cb5-8d9444c417dc
		summarizeBy: none
		sourceColumn: Ville et musee (colonne ref)

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Libellé « Musée - Ville » affiché dans le segment de sélection. Trié par [Tri segment].
	column 'Segment musee et ville'
		dataType: string
		lineageTag: 2d366198-a801-411d-8091-595013cf9259
		summarizeBy: none
		sourceColumn: Segment musee et ville
		sortByColumn: 'Ville et musee (colonne ref)'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	/// URL Google Maps d’itinéraire vers l’adresse formatée du musée (bouton « Itinéraire »).
	column 'Itinéraire formate'
		dataType: string
		lineageTag: d03303fa-7f70-4482-95ad-83362bd24e61
		summarizeBy: none
		sourceColumn: Itinéraire formate

		annotation SummarizationSetBy = Automatic

	/// URL de la page OpenWeather de la ville du musée (bouton « Voir la météo en temps réel »).
	column 'lien url vers site meteo'
		dataType: string
		lineageTag: 9d626975-b9a0-4086-ba7a-abbebedda255
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: lien url vers site meteo

